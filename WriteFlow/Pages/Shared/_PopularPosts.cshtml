@model List<WriteFlow.CoreLayer.DTOs.Posts.PostDto>
@using WriteFlow.CoreLayer.Utilities
@if (Model.Any())
{
    <h3 style="font-size: 1rem; font-weight: 800; color: var(--dark); margin-bottom: 1rem; border-bottom: 2px solid var(--border); padding-bottom: 0.5rem;">
        🔥 محبوب‌ترین و پربازدیدترین‌ها
    </h3>

    <div style="display: flex; flex-direction: column; gap: 1rem;">
        @foreach (var popularPost in Model)
        {
            <a asp-page="Article" asp-route-slug="@popularPost.Slug" style="display: flex; gap: 0.75rem; text-decoration: none; align-items: center; border-bottom: 1px solid var(--border); padding-bottom: 0.75rem;">
                <img src="@Directories.GetPostImage(popularPost.ImageName)" alt="@popularPost.Title" style="width: 65px; height: 65px; object-fit: cover; border-radius: var(--radius-sm, 6px); flex-shrink: 0;" />
                <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                    <h4 style="font-size: 0.825rem; font-weight: 700; color: var(--dark); margin: 0; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                        @popularPost.Title
                    </h4>
                    <span style="font-size: 0.725rem; color: var(--text-muted);">👁️ @popularPost.VisitCount بازدید</span>
                </div>
            </a>
        }
    </div>
    
}