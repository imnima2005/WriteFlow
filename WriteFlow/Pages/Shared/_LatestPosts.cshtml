@using WriteFlow.CoreLayer.Utilities
@model List<WriteFlow.CoreLayer.DTOs.Posts.PostDto>
@foreach (var post in Model)
{
    <!-- کارت مقاله عادی -->
    <a asp-page="Article" asp-route-slug="@post.Slug" class="card" style="padding: 0 !important; overflow: hidden; display: flex; flex-direction: column; text-decoration: none; color: inherit;">

        <!-- تصویر کارت -->
        <div style="width: 100%; height: 150px; overflow: hidden;">
            <img src="@Directories.GetPostImage(post.ImageName)" alt="@post.Title" style="width: 100%; height: 100%; object-fit: cover; display: block;" loading="lazy" />
        </div>

        <!-- محتوای متنی کارت -->
        <div style="padding: 0.9rem; display: flex; flex-direction: column; flex-grow: 1;">

            <!-- هدر متن: تایتل و نام نویسنده در یک ردیف -->
            <div style="display: flex; justify-content: space-between; align-items: baseline; gap: 0.5rem; margin-bottom: 0.5rem;">
                <h4 style="font-size: 0.95rem; font-weight: 800; color: var(--dark); margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                    @post.Title
                </h4>
                <span style="font-size: 0.65rem; font-weight: 400; color: var(--text-muted); white-space: nowrap;">
                    @post.CreationDate.GetTimeAgo()
                </span>
            </div>

            <!-- توضیحات کوتاه -->
            <p style="font-size: 0.8rem; color: var(--text-muted); margin: 0 0 1rem 0; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                @post.ShortDescription
            </p>

            <!-- فوتر: بازدید و زمان انتشار با رنگ و فونت یکدست -->
            <div style="margin-top: auto; padding-top: 0.5rem; border-top: 1px solid var(--border); font-size: 0.75rem; color: var(--text-muted); display: flex; justify-content: center; align-items: center; gap: 0.4rem;">
                <span>✍️ @post.UserFullName</span>
                <span>|</span>
                <span>👁️ @post.VisitCount بازدید</span>
            </div>

        </div>
    </a>
}
