@model WriteFlow.Areas.Admin.Models.Post.CreatePostViewModel
@using WriteFlow.CoreLayer.Services.Categories;
@inject ICategoryServices _categoryServices;
@{
    ViewData["Title"] = "افزودن مقاله جدید";
    ViewData["selected"] = "category";
    var categories = _categoryServices.GetAllcategory();
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/post/post-create.css" />
}

<div class="card post-create-card">
    <div class="post-create-header">
        <div>
            <h2 class="post-create-title">ایجاد مقاله جدید</h2>
            <p class="post-create-subtitle">محتوا و جزئیات مقاله را برای انتشار وارد کنید</p>
        </div>
        <a asp-area="Admin" asp-controller="Post" asp-action="Index" class="btn btn-outline post-create-back-btn">
            ← بازگشت
        </a>
    </div>

    <form method="post" asp-area="Admin" asp-controller="Post" asp-action="Create" enctype="multipart/form-data">

        <div class="post-create-grid-2col">
            <div class="form-group post-create-form-group">
                <label class="form-label post-create-label">
                    عنوان مقاله <span class="post-create-required">*</span>
                </label>
                <input asp-for="Title" type="text" class="form-control" placeholder="عنوان مقاله را وارد کنید..." required />
            </div>

            <div class="form-group post-create-form-group">
                <label class="form-label post-create-label">
                    توضیحات کوتاه <span class="post-create-required">*</span>
                </label>
                <input asp-for="ShortDescription" type="text" class="form-control" placeholder="توضیحات کوتاه را وارد کنید..." required />
            </div>
        </div>

        <div class="post-create-grid-3col">
            <div class="form-group post-create-form-group">
                <label class="form-label post-create-label">
                    اسلاگ (Slug / URL) <span class="post-create-required">*</span>
                </label>
                <input asp-for="Slug" type="text" class="form-control post-create-slug-input" placeholder="example-article-slug" required />
                <small class="post-create-hint">عنوان مقاله در آدرس مرورگر</small>
            </div>

            <div class="form-group post-create-form-group">
                <label asp-for="CategoryId" class="form-label post-create-label">
                    موضوع <span class="post-create-required">*</span>
                </label>
                <select asp-for="CategoryId" class="form-control post-create-select" required>
                    <option value='null' disabled selected hidden>انتخاب کنید</option>
                    @foreach (var item in categories.Where(c => c.ParentId == null))
                    {
                        <option value="@item.Id">@item.Title</option>
                    }
                </select>
                <span asp-validation-for="CategoryId"></span>
            </div>

            <div class="form-group post-create-form-group">
                <label asp-for="SubCategoryId" class="form-label post-create-label">
                    دسته بندی <span class="post-create-required">*</span>
                </label>
                <select asp-for="SubCategoryId" class="form-control post-create-select">
                    <option value="">ابتدا موضوع را انتخاب کنید</option>
                </select>
                <span asp-validation-for="SubCategoryId"></span>
            </div>
        </div>

        <div class="post-create-grid-media">
            <div class="form-group post-create-form-group">
                <label class="form-label post-create-label">
                    تصویر شاخص مقاله <span class="post-create-required">*</span>
                </label>
                <input asp-for="ImageFile" type="file" accept="image/*" class="form-control post-create-file-input" required />
                <small class="post-create-hint">فرمت‌های مجاز: JPG, PNG, WEBP</small>
            </div>

            <div class="form-group post-create-form-group post-create-checkbox-group">
                <label class="form-label post-create-label">
                    پست ویژه
                </label>
                <label class="post-create-checkbox-label">
                    <input asp-for="IsSpecial" type="checkbox" class="post-create-checkbox" />
                    <span class="post-create-checkbox-text">نمایش در بخش ویژه</span>
                </label>
                <span asp-validation-for="IsSpecial"></span>
            </div>
        </div>

        <div class="form-group post-create-editor-container">
            @Html.EditorFor(m => m.Description, "Ckeditor4")
        </div>

        <div class="post-create-actions">
            <button type="submit" class="btn btn-primary post-create-submit-btn">انتشار مقاله</button>
            <a asp-area="Admin" asp-controller="Post" asp-action="Index" class="btn btn-outline post-create-cancel-btn">انصراف</a>
        </div>

    </form>
</div>

@section Scripts{
    <script>
        $("#CategoryId").change(function () {
            var categoryId = $(this).val();
            if (!categoryId || categoryId === "null" || categoryId === "") {
                $("#SubCategoryId").html("<option value=''>ابتدا موضوع را انتخاب کنید</option>");
                return;
            }
            $.ajax({
                url: "/admin/category/GetChildCategories?parentId=" + categoryId,
                type: "get"
            }).done(function (data) {
                if (data && data.length > 0) {
                    $("#SubCategoryId").html("<option value=''>انتخاب کنید (اختیاری)</option>");
                    for (var i in data) {
                        var category = data[i];
                        $("#SubCategoryId").append(`<option value='${category.id}'>${category.title}</option>`);
                    }
                } else {
                    $("#SubCategoryId").html("<option value=''>بدون زیرگروه</option>");
                }
            })
        })
    </script>
}
