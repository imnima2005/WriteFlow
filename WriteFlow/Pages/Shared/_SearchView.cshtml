@model WriteFlow.CoreLayer.DTOs.Posts.PostFilterDto
@using WriteFlow.CoreLayer.Utilities

<div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1.25rem;">
    @if (Model.Posts != null && Model.Posts.Any())
    {
        @foreach (var post in Model.Posts)
        {
            <article class="card" style="padding: 0; overflow: hidden; display: flex; flex-direction: column; transition: transform 0.2s;" onmouseover="this.style.transform='translateY(-4px)'" onmouseout="this.style.transform='translateY(0)'">
                <!-- تصویر مقاله -->
                <a asp-page="Article" asp-route-slug="@post.Slug" style="display: block; position: relative; width: 100%; line-height: 0;">
                    <img src="@Directories.GetPostImage(post.ImageName)" alt="@post.Title" style="width: 100%; height: 160px; object-fit: cover; display: block;" />
                    @if (post.SubCategory != null)
                    {

                        <span class="badge" style="position: absolute; top: 0.75rem; right: 0.75rem; background: rgba(255, 255, 255, 0.9); color: var(--dark); border: 1px solid var(--border); line-height: 1;">
                            @post.SubCategory.Title
                        </span>
                    }
                    else
                    {
                        <span class="badge" style="position: absolute; top: 0.75rem; right: 0.75rem; background: rgba(255, 255, 255, 0.9); color: var(--dark); border: 1px solid var(--border); line-height: 1;">
                            @post.Category.Title
                        </span>
                    }
                </a>
                <a asp-page="Search" asp-route-categorySlug="@post.Category.Slug"></a>

                <!-- محتوای کارت -->
                <div style="padding: 1rem; display: flex; flex-direction: column; flex-grow: 1;">
                    <h2 style="font-size: 0.95rem; font-weight: 800; margin: 0 0 0.5rem 0; line-height: 1.45;">
                        <a asp-page="Article" asp-route-slug="@post.Slug" style="color: var(--dark); text-decoration: none;">
                            @post.Title
                        </a>
                    </h2>

                    <p style="font-size: 0.825rem; color: var(--text-muted); line-height: 1.6; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin-bottom: 1rem;">
                        @post.ShortDescription
                    </p>

                    <!-- متای پایین کارت -->
                    <div style="margin-top: auto; padding-top: 0.75rem; border-top: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; font-size: 0.775rem; color: var(--text-muted);">
                        <span>✍️ @post.UserFullName</span>
                        <span>👁️ @post.VisitCount</span>
                    </div>
                </div>
            </article>
        }
    }
    else
    {
        <div class="card" style="grid-column: 1 / -1; padding: 3rem; text-align: center; color: var(--text-muted);">
            <p style="font-size: 1.1rem; font-weight: 700; margin-bottom: 0.5rem; color: var(--dark);">مقاله‌ای یافت نشد!</p>
            <p style="font-size: 0.875rem; margin: 0;">متاسفانه کلمه‌ای که جستجو کرده‌اید یا دسته‌بندی انتخابی، در حال حاضر مقاله‌ای ندارد.</p>
        </div>
    }
</div>

<partial name="_PaginationSearch" model="Model" />